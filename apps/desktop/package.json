{
  "name": "manor",
  "private": true,
  "version": "0.22.11",
  "repository": "github:orrybaram/manor",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/patch-electron-name.mjs && vite",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.electron.json",
    "build": "pnpm typecheck && vite build",
    "build:web": "vite build --config vite.web.config.ts",
    "build:web:relay": "node scripts/build-web-relay.mjs",
    "preview": "vite preview",
    "package": "pnpm typecheck && vite build && node scripts/build-host-tarball.mjs && electron-builder",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && pnpm build:web:relay && playwright test --project=e2e && playwright test --project=perf",
    "test:e2e:smoke": "pnpm build && pnpm build:web:relay && playwright test --project=e2e --grep @smoke",
    "e2e:smoke": "playwright test --project=e2e --grep @smoke",
    "test:e2e:remote-host": "node scripts/test-remote-e2e.mjs",
    "test:e2e:remote-host:docker": "node scripts/test-remote-e2e.mjs --docker",
    "test:e2e:web": "pnpm build && pnpm build:web:relay && playwright test tests/e2e/web-app.spec.ts",
    "e2e:web": "playwright test tests/e2e/web-app.spec.ts",
    "test:e2e:relay": "pnpm build && pnpm build:web:relay && playwright test tests/e2e/relay.spec.ts tests/e2e/pairing-ticket.spec.ts",
    "e2e:relay": "playwright test tests/e2e/relay.spec.ts tests/e2e/pairing-ticket.spec.ts",
    "test:e2e:mobile": "pnpm build && pnpm build:web:relay && playwright test tests/e2e/mobile-audit.spec.ts",
    "e2e:mobile": "playwright test tests/e2e/mobile-audit.spec.ts",
    "postinstall": "electron-rebuild",
    "relay:dev:upload": "node scripts/upload-web-relay.mjs --local"
  },
  "dependencies": {
    "@electron/osx-sign": "^2.3.0",
    "@formkit/auto-animate": "^0.10.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@noble/curves": "^2.4.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/react-visually-hidden": "^1.2.3",
    "@tanstack/react-query": "^5.91.2",
    "@tanstack/react-virtual": "^3.13.23",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "cmdk": "^1.1.1",
    "electron-updater": "^6.3.4",
    "emojibase-data": "^17.0.0",
    "lucide-react": "^0.577.0",
    "node-pty": "^1.0.0",
    "portless": "^0.7.2",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "refractor": "^5.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tree-kill": "^1.2.2",
    "web-push": "^3.6.7",
    "ws": "^8.21.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electron/rebuild": "^4.0.3",
    "@manor/protocol": "workspace:*",
    "@playwright/test": "^1.59.1",
    "@types/hast": "^3.0.5",
    "@types/node": "^25.5.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "happy-dom": "^20.14.3",
    "jsdom": "^30.0.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.1.0"
  },
  "build": {
    "appId": "com.manor.app",
    "productName": "Manor",
    "publish": {
      "provider": "github"
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "extendInfo": {
        "NSUserNotificationAlertStyle": "alert"
      }
    },
    "dmg": {
      "artifactName": "${productName}-${arch}.dmg"
    },
    "files": [
      "dist/**/*",
      "!dist/mac-arm64",
      "!dist/builder-effective-config.yaml",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "docker/host-image",
        "to": "host-image"
      }
    ],
    "asarUnpack": [
      "dist-electron/mcp-webview-server.js",
      "dist-electron/agent-hook.js",
      "dist-electron/manor-cli.js"
    ]
  }
}
