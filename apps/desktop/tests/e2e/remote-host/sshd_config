# Drop-in for the E2E container's sshd (see Dockerfile).
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
PermitRootLogin no
AllowUsers manor
# Port forwards ride the ControlMaster with `ssh -O forward -L`.
AllowTcpForwarding yes
UseDNS no
# Every session runs through this wrapper (see Dockerfile), as the private
# sshd's sessions run through its wrap.sh. The box's host server
# dials MANOR_RELAY_URL: never the production relay from a test box. The
# wrapper sets a closed local port, unless a spec points it at its own local
# relay through ~/.manor-e2e/env (helpers/remote-host.ts
# `pointHostServerAtRelay`, with `reachRelayFromBox` forwarding the relay's
# port into the container).
ForceCommand /usr/local/bin/manor-e2e-session
