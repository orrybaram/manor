{
  "name": "manor-site",
  "private": true,
  "type": "module",
  "description": "The Manor marketing homepage (manor.sh): Vite + vanilla TypeScript, static output.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "SITE_VERSION_STRICT=1 pnpm build && wrangler deploy",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@manor/cobwebs": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "wrangler": "^4.157.0"
  }
}
