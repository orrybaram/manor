{
  "name": "manor-monorepo",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "dev": "pnpm --filter manor dev",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm --filter manor build",
    "build:web": "pnpm --filter manor build:web",
    "build:web:relay": "pnpm --filter manor build:web:relay",
    "preview": "pnpm --filter manor preview",
    "package": "source .env && pnpm --filter manor package",
    "test": "pnpm test:unit && pnpm knip:ci",
    "test:unit": "pnpm --filter manor --filter @manor/protocol --filter @manor/cobwebs test",
    "knip": "knip",
    "knip:ci": "knip --include files,dependencies,unlisted,binaries",
    "knip:fix": "knip --fix",
    "test:watch": "pnpm --filter manor test:watch",
    "test:e2e": "pnpm --filter manor test:e2e",
    "test:e2e:smoke": "pnpm --filter manor test:e2e:smoke",
    "e2e:smoke": "pnpm --filter manor e2e:smoke",
    "test:e2e:remote-host": "pnpm --filter manor test:e2e:remote-host",
    "test:e2e:remote-host:docker": "pnpm --filter manor test:e2e:remote-host:docker",
    "test:e2e:web": "pnpm --filter manor test:e2e:web",
    "e2e:web": "pnpm --filter manor e2e:web",
    "test:e2e:relay": "pnpm --filter manor test:e2e:relay",
    "e2e:relay": "pnpm --filter manor e2e:relay",
    "test:e2e:mobile": "pnpm --filter manor test:e2e:mobile",
    "e2e:mobile": "pnpm --filter manor e2e:mobile",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "kill": "test -f ~/.manor/daemon/terminal-host.pid && kill $(cat ~/.manor/daemon/terminal-host.pid) 2>/dev/null; rm -f ~/.manor/daemon/terminal-host.pid ~/.manor/daemon/terminal-host.sock ~/.manor/daemon/terminal-host.token",
    "release": "node scripts/release.mjs",
    "relay:dev": "pnpm --filter manor-relay run dev",
    "relay:test": "pnpm --filter manor-relay run test",
    "relay:dev:upload": "pnpm --filter manor relay:dev:upload",
    "relay:deploy": "pnpm --filter manor-relay run deploy",
    "site:dev": "pnpm --filter manor-site dev",
    "site:build": "pnpm --filter manor-site build",
    "site:preview": "pnpm --filter manor-site preview"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "knip": "^6.32.2",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.1"
  }
}
