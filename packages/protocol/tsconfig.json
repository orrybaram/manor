{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "ES2022.Error", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
